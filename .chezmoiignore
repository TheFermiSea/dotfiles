# them guarantees conflicts and stale-token reverts. On 2026-09-11 the repo
# would have rolled ~/.codex/auth.json back to a January token.
# ---------------------------------------------------------------------------
.codex/auth.json
.gemini/oauth_creds.json
.gemini/google_accounts.json
.config/opencode/auth.json
.claude/.credentials.json
.aws/credentials
.netrc

