{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "plugin": [
    "/Users/briansquires/dev/oc-plugins/morph-fast-apply",
    "opencode-openai-codex-auth"
  ],
  "instructions": [
    "/Users/briansquires/dev/oc-plugins/morph-fast-apply/MORPH_INSTRUCTIONS.md",
    "/Users/briansquires/.config/opencode/colgrep-instructions.md"
  ],
  "mcp": {
    "morph-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
