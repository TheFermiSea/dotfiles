# Cursor Agent shell integration is expensive to generate; cache the generated
# script so the behavior stays intact without re-running the generator on every
# shell startup. Auto-record is disabled by default for faster startup, but can
# be re-enabled for a shell by setting ENABLE_CURSOR_AGENT_AUTO_RECORD=1.
load_cursor_agent_shell_integration() {
    if [[ -n "${_CURSOR_AGENT_SHELL_INTEGRATION_LOADED:-}" ]]; then
        return
    fi

    local agent_cmd="$HOME/.local/bin/agent"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
    local cache_file="$cache_dir/cursor-agent-shell-integration.zsh"
    local chat_id_file="$cache_dir/cursor-agent-chat-id"
    local cached_chat_id
    local tmp_file

    if [[ ! -x "$agent_cmd" ]]; then
        return
    fi

    mkdir -p "$cache_dir" || return

    if [[ -z "${ENABLE_CURSOR_AGENT_AUTO_RECORD:-}" && -z "${CURSOR_RECORD_SESSION:-}" ]]; then
        export CURSOR_RECORD_SESSION=1
    fi

    if [[ -z "${CURSOR_AGENT_CHAT_ID:-}" && -r "$chat_id_file" ]]; then
        cached_chat_id=$(<"$chat_id_file")
        if [[ -n "$cached_chat_id" ]]; then
            export CURSOR_AGENT_CHAT_ID="$cached_chat_id"
        fi
    fi

    if [[ ! -r "$cache_file" || "$agent_cmd" -nt "$cache_file" ]]; then
        tmp_file="$cache_file.$$"
        if "$agent_cmd" shell-integration zsh >| "$tmp_file"; then
            mv -f "$tmp_file" "$cache_file"
        else
            rm -f "$tmp_file"
        fi
    fi

    if [[ -r "$cache_file" ]]; then
        _CURSOR_AGENT_SHELL_INTEGRATION_LOADED=1
        source "$cache_file"
    fi

    if [[ -n "${CURSOR_AGENT_CHAT_ID:-}" ]]; then
        print -r -- "$CURSOR_AGENT_CHAT_ID" >| "$chat_id_file"
    fi
}

load_cursor_agent_shell_integration

