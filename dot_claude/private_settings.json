{
  "includeGitInstructions": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "codex@openai-codex": true,
    "asta-preview@asta-plugins": true,
    "asta-tools@asta-plugins": true,
    "asta-flows@asta-plugins": true,
    "asta-dev@asta-plugins": true,
    "asta-assistant@asta-plugins": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "directory",
        "path": "/Users/briansquires/.claude/local-marketplaces/mattpocock"
      }
    },
    "asta-plugins": {
      "source": {
        "source": "github",
        "repo": "allenai/asta-plugins"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "askUserQuestionTimeout": "5m",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "attribution.commit": false,
  "attribution.pr": false,
  "statusLine": {
    "type": "command",
    "command": "python3 $HOME/.claude/hooks/statusline.py"
  }
}